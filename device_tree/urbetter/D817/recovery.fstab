# recovery.fstab — urbetter/D817 (P817, RK3288W)
# ★ 2026-10-12 根因修复 v1：原版全部使用 /dev/block/rknand_* 节点，
#   但本机实测 /dev/block/ 下【只有】mmcblk0/mmcblk0p1..p14/mmcblk1(+p1,p2)，
#   不存在任何 rknand_* 节点 → 挂载必然全败。
#   分区号来自真机 /proc/partitions 实测（见 FIXPLAN_v1.md 表）。
#
# 格式兼容 TWRP 2.8.7.x（omni twrp-4.4）与 TWRP 3.x：
#   <mount_point>  <type>  <device>  <flags>

# --- 可读写文件系统 ---
/system           ext4   /dev/block/mmcblk0p10   flags=display=system
/cache            ext4   /dev/block/mmcblk0p8    flags=display=cache
/metadata         ext4   /dev/block/mmcblk0p11   flags=display=metadata
/data             ext4   /dev/block/mmcblk0p14   flags=display=data
/radical_update   ext4   /dev/block/mmcblk0p12   flags=display=radical_update

# --- 只读/镜像分区（emmc 类型，TWRP 用于备份/还原，不挂载） ---
/boot             emmc   /dev/block/mmcblk0p5    flags=display=boot
/recovery         emmc   /dev/block/mmcblk0p6    flags=display=recovery
/backup           emmc   /dev/block/mmcblk0p7    flags=display=backup
/kpanic           emmc   /dev/block/mmcblk0p9    flags=display=kpanic
/system2          emmc   /dev/block/mmcblk0p13   flags=display=system2

# --- 可移动存储 ---
/mnt/external_sd  vfat   /dev/block/mmcblk1p1    flags=display=external_sd;removable
/mnt/usbstorage   vfat   /dev/block/sda1         flags=display=usb;removable
